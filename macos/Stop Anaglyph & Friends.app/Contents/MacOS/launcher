#!/bin/bash
set -u

PID_DIR="$HOME/Library/Application Support/Anaglyph-and-Friends"

stop_pid() {
  local file="$1"
  if [ -f "$file" ]; then
    local pid
    pid="$(cat "$file")"
    if kill -0 "$pid" 2>/dev/null; then
      kill "$pid" 2>/dev/null || true
      for attempt in $(seq 1 20); do
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.1
      done
      kill -9 "$pid" 2>/dev/null || true
    fi
    rm -f "$file"
  fi
}

stop_pid "$PID_DIR/frontend.pid"
stop_pid "$PID_DIR/backend.pid"

/usr/bin/osascript -e 'display notification "Local servers stopped." with title "Anaglyph & Friends"'
